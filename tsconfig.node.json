{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun", "vite/client"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "src/test",
    "src/engine/**/*.test.ts",
    "src/engine/fs/nodeDirHandle.ts",
    "src/ui/**/*.test.ts",
    "src/ui/**/*.test.tsx",
    "src/vite-env.d.ts"
  ]
}
