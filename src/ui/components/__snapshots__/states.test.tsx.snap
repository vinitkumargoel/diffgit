          class="min-w-0"
        >
          <h1
            class="text-[21px] leading-[1.15] font-semibold tracking-[-0.02em]"
          >
            Something went wrong
          </h1>
          <div
            class="mt-1 font-mono text-[11.5px] break-all text-muted/70"
            data-testid="error-code"
          >
            INTERNAL
            <span
              class="text-muted"
            >
               · 
              basic
            </span>
          </div>
        </div>
      </div>
      <p
        class="text-[14.5px] leading-[22px] text-ink/80"
      >
        An internal error occurred. This is a bug in diffgit, not in your repository.
      </p>
      <dl
        class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2 rounded-[8px] border border-line bg-surface-sunken px-[14px] py-3 text-[13.5px] leading-[20px]"
      >
        <dt
          class="pt-[3px] font-mono text-[11px] font-medium tracking-[0.04em] text-muted/70 uppercase"
        >
          What to do
        </dt>
        <dd
          class="m-0"
        >
          Retry. If it happens again, copy the details and open an issue — the report contains no file contents.
        </dd>
      </dl>
      <div
        class="flex flex-wrap items-center gap-2"
      >
        <button
          class="btn btn-ink px-3.5 py-2 text-[13.5px]"
          type="button"
        >
          Retry
        </button>
        <button
          class="btn px-3.5 py-2 text-[13.5px]"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-copy"
            fill="none"
            height="13"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="13"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect
              height="14"
              rx="2"
              ry="2"
              width="14"
              x="8"
              y="8"
            />
            <path
              d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
            />
          </svg>
          Copy report
        </button>
        <span
          class="ml-auto flex items-center gap-2"
        >
          <button
            class="btn btn-ghost px-3.5 py-2 text-[13.5px]"
            type="button"
          >
            Back to start
          </button>
        </span>
      </div>
      <details
        class="border-t border-line pt-2.5 text-[12.5px] text-muted"
        open=""
      >
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 font-medium [&::-webkit-details-marker]:hidden"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-chevron-right"
            fill="none"
            height="12"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="12"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m9 18 6-6-6-6"
            />
          </svg>
          Details
        </summary>
        <pre
          class="mt-2 max-h-48 overflow-auto rounded-[6px] border border-line bg-surface-raised px-3 py-2.5 font-mono text-[11.5px] leading-[1.5] break-all whitespace-pre-wrap text-ink/80"
          data-testid="error-report"
        >
          &lt;error report&gt;
        </pre>
      </details>
    </div>
  </div>
</main>
`;

