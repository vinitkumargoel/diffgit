{
  "name": "diffgoel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -b && biome check . && bun run test && bun run test:ui && bash scripts/check-guards.sh",
    "test": "bun test src/engine src/test",
    "test:ui": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "fixtures": "bash scripts/make-fixtures.sh && bash scripts/fixture-expectations.sh",
    "deploy": "bun run build && bunx wrangler pages deploy dist --project-name diffgoel",
    "check:prod": "bash scripts/check-prod.sh"
  },
  "dependencies": {
    "comlink": "4.4.2",
    "idb-keyval": "6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
