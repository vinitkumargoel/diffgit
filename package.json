{
  "name": "diffgit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -b && biome check . && bun run test && bun run test:ui && bash scripts/check-guards.sh",
    "test": "bun test src/engine src/test",
    "test:ui": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "fixtures": "bash scripts/make-fixtures.sh && bash scripts/fixture-expectations.sh",
    "record": "TZ=UTC bun run scripts/record-fixtures.ts && biome format --write src/test/recorded",
    "deploy": "bun run build && scripts/check-dist.sh && bunx wrangler pages deploy dist --project-name diffgoel --force",
    "check:prod": "bash scripts/check-prod.sh",
    "e2e": "playwright test",
    "perf": "bun run scripts/perf.ts"
  },
  "dependencies": {
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tanstack/react-virtual": "3.14.13",
    "buffer": "6.0.3",
    "cmdk": "1.1.1",
    "comlink": "4.4.2",
    "diff": "9.0.0",
    "idb-keyval": "6.3.0",
    "ignore": "7.0.9",
    "isomorphic-git": "1.42.2",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/diff": "8.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
